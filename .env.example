# URL da página de ingressos
URL_ALVO=https://exemplo.com/ingressos

# Seletor das datas disponíveis no HTML (classe, ID ou texto)
SELETOR_DATA=.data-disponivel

# A data específica que você está procurando para ser notificado (ex: 20/07/2026)
DATA_ALVO=20/07/2026

# Configurações do Resend (Desativado por padrão)
ENABLE_RESEND=false
RESEND_API_KEY=re_suachaveaqui
EMAIL_REMETENTE=onboarding@resend.dev
EMAIL_DESTINO=seu-email@exemplo.com

# Intervalo entre checagens em minutos
INTERVALO_MINUTOS=5

# Diretório para armazenamento da sessão
SESSION_DIR=./session

# Desabilita o BuildKit e usa o builder legado do Docker (útil para resolver erro de 'exec format error' no buildx)
DOCKER_BUILDKIT=0
COMPOSE_DOCKER_CLI_BUILD=0

# Fuso horário (UTC-3)
TZ=America/Sao_Paulo
